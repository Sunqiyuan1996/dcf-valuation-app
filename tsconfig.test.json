{
  "//": "Compiles the pure-logic modules plus the offline test suite to CommonJS so `npm test` can run them under plain node. The app itself still builds through tsconfig.json.",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "dom"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-build",
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["test/engine.test.ts", "lib/dcf.ts", "lib/adjustments.ts", "lib/statements.ts", "lib/types.ts"]
}
